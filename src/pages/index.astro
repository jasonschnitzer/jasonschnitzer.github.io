---
import BaseLayout from '../layouts/BaseLayout.astro';

const news = [
  {
    date: 'Sept 26, 2026',
    text: 'Presenting "Broadband After BEAD: The Emerging Policy Challenge of Network Availability" (with D. Reed) at TPRC 54, the Telecommunications Policy Research Conference.',
  },
  {
    date: '2026',
    text: 'Completed Ph.D. in Telecommunications at CU Boulder — dissertation: "Autonomic DOCSIS Networking," advised by Sangtae Ha.',
  },
];
---

<BaseLayout
  title="Jason Schnitzer"
  description="Senior Research Associate at CU Boulder working on autonomic network management, broadband measurement, and broadband policy."
>
  <section>
    <h1>Jason Schnitzer</h1>
    <p>
      Senior Research Associate, Department of Computer Science <br />
      University of Colorado Boulder <br />
      Leads the Broadband Measurement Clearinghouse (BCLEAR)
    </p>
    <p>
      I work on autonomic and programmable network management, broadband
      performance measurement, and broadband policy — mostly centered on
      DOCSIS/HFC access networks, with an emerging focus on AI/RL-driven
      network control and low-latency 5G/6G convergence. My Ph.D. work
      developed closed-loop (MAPE) autonomic control for DOCSIS 4.0 access
      networks; more recently I've been working on how broadband
      availability and reliability get measured and defined for policy,
      including the FCC's Measuring Broadband America program and the
      BEAD program's network availability requirements.
    </p>
    <p>
      <a href="mailto:jason@schnitzer.ca">jason@schnitzer.ca</a>
      &middot; <a href="/cv/">CV</a>
      &middot; <a href="https://github.com/jasonschnitzer">GitHub</a>
      &middot; <a href="https://scholar.google.com/">Google Scholar</a>
    </p>
  </section>

  <section>
    <h2>News</h2>
    <ul class="news-list">
      {news.map((item) => (
        <li>
          <span class="news-date">{item.date}</span>
          {item.text}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

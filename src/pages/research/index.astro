---
import BaseLayout from '../../layouts/BaseLayout.astro';

const areas = [
  {
    title: 'Autonomic & programmable DOCSIS networking',
    body: 'Self-optimization and self-configuration of cable access networks via closed-loop (MAPE: Monitor–Analyze–Plan–Execute) control. My dissertation demonstrated this on two problems: self-optimizing DOCSIS 4.0 OFDM downstream channel modulation profiles (subcarrier bit-loading at the PHY layer), and self-configuring MAC-layer QoS resources for low-latency mobile backhaul.',
  },
  {
    title: 'DOCSIS/HFC protocol and network management',
    body: "A taxonomy of DOCSIS management protocols and data models across versions, the “network management gap” between protocol capability and operational tooling, the FCAPS/OSSI framework, and distributed access architectures (Remote-PHY/MAC).",
  },
  {
    title: 'Low-latency access networking & 5G/6G convergence',
    body: 'Low Latency DOCSIS (LLD) vs. Low Latency xHaul (LLX) for mobile backhaul over DOCSIS; a proposed "Latency Mitigation Function" using programmable MAC-layer control; DOCSIS QoS mechanisms (PGS, RTPS, UGS, PCMM).',
  },
  {
    title: 'Broadband performance measurement',
    body: "Longitudinal, empirical analysis of the FCC's 13-year Measuring Broadband America (MBA) dataset (3.5B+ latency observations), measurement methodology critique, and implications for the FCC's proposed Broadband Consumer Label.",
  },
  {
    title: 'Broadband and telecom policy',
    body: 'Network availability definitions under BEAD, and measurement methodology standardization (ITU-T Y.1540, IETF RFC 9544) — bridging engineering measurement practice with how regulators actually define and enforce reliability.',
  },
];
---

<BaseLayout title="Research | Jason Schnitzer">
  <h1>Research</h1>
  <p>
    My research sits at the intersection of network management, broadband
    measurement, and broadband policy — largely grounded in DOCSIS/HFC
    access networks, with an emerging interest in ultra-low-latency links
    and reinforcement-learning agents for autonomic network control more
    broadly.
  </p>

  {areas.map((area) => (
    <section>
      <h2>{area.title}</h2>
      <p>{area.body}</p>
    </section>
  ))}
</BaseLayout>

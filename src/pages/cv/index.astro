---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | Jane Q. Engineer">
  <h1>CV</h1>
  <p>
    <a href="/cv/cv.pdf">Download CV (PDF)</a> &mdash; replace
    <code>public/cv/cv.pdf</code> with your actual CV file.
  </p>

  <section>
    <h2>Education</h2>
    <ul>
      <li>Ph.D., [Field], [University], [Year]</li>
      <li>M.S., [Field], [University], [Year]</li>
      <li>B.S., [Field], [University], [Year]</li>
    </ul>
  </section>

  <section>
    <h2>Appointments</h2>
    <ul>
      <li>Assistant Professor, [Department], University of Colorado Boulder, [Year&ndash;present]</li>
    </ul>
  </section>

  <section>
    <h2>Selected Honors &amp; Awards</h2>
    <ul>
      <li>[Award Name], [Year]</li>
      <li>[Award Name], [Year]</li>
    </ul>
  </section>
</BaseLayout>
